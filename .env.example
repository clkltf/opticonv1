# Copy to .env and never commit the real file.
DOMAIN=localhost
PORT=8080
POSTGRES_DB=opticon
POSTGRES_USER=opticon
POSTGRES_PASSWORD=CHANGE_ME
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://opticon:CHANGE_ME@postgres:5432/opticon

STALE_MS=3000
MIN_NET_EDGE_BPS=10
DEFAULT_TAKER_FEE_BPS=10
MIN_LIQUIDITY_USDT=25000
ORDERBOOK_SYMBOL_LIMIT=120
DEFAULT_NOTIONAL_USDT=1000
MAX_NOTIONAL_USDT=1000000
RECORD_INTERVAL_SEC=5
RETENTION_DAYS=30

# Optional exchange credentials. Scanner uses public market data where possible.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DEX_ENABLED=false
GECKOTERMINAL_INTERVAL_SEC=30
DEX_NETWORKS=solana,eth,base,bsc
ALERT_SCORE=85
ALERT_COOLDOWN_SEC=120
